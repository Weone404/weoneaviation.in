import Layout from '../components/Layout';
import Link from 'next/link';
import Breadcrumb from '../components/Breadcrumb';
import QuickAnswer from '../components/QuickAnswer';
import SummaryBox from '../components/SummaryBox';
import PeopleAlsoAsk from '../components/PeopleAlsoAsk';
import LeadForm from '../components/LeadForm';
import ScrollReveal from '../components/ScrollReveal';
import StructuredData from '../components/StructuredData';
import { generateFAQSchema } from '../lib/schema';
import { LICENCES, MIN_AGE, CPL_HOURS } from '../lib/facts';

/*
 * REWRITTEN FROM A 16-LINE STUB — AND CORRECTED ON THE FACTS.
 *
 * The previous version described a "Sport Pilot License": light-sport
 * aircraft, "no complex DGCA medicals", "Endorsed by DGCA", a fee band
 * mislabelled as a salary. Sport Pilot is a United States FAA category. It
 * does not exist under Indian rules, so the page was selling a licence the
 * DGCA does not issue, on a URL (/student-pilot-license-spl) that names a
 * completely different one.
 *
 * In India SPL is the STUDENT Pilot Licence — the first licence in the chain,
 * set out in the Aircraft Rules, 1937, Schedule II, Section B, minimum age 16.
 * That is what this page now describes.
 */

const LAST_UPDATED = 'August 24, 2026';
const LAST_UPDATED_ISO = '2026-08-24';

/*
 * Derived from lib/facts.js rather than retyped. The four ages appear on a
 * dozen pages; holding them in one module is what stops them drifting apart.
 */
const licenceLadder = LICENCES.map((l) => ({
  licence: `${l.code} — ${l.name}`,
  age: `${l.minAge} years`,
  section: l.section,
  what: l.permits,
}));

const peopleAlsoAsk = [
  {
    q: 'What does SPL stand for in Indian aviation?',
    a: 'Student Pilot Licence. It is the first licence in the DGCA chain, issued under Schedule II, Section B of the Aircraft Rules, 1937. If you have read about a "Sport Pilot Licence", that is a United States FAA category and it does not exist under Indian rules.',
  },
  {
    q: 'What is the minimum age for a Student Pilot Licence?',
    a: 'Sixteen years, under Schedule II, Section B. That makes the SPL the earliest point at which most students can formally enter the licensing chain, a full year before a PPL and two before a CPL.',
  },
  {
    q: 'Can I fly solo on a Student Pilot Licence?',
    a: 'Yes, that is largely what it exists for. Solo flying happens under the authorisation of your instructor and within the limits your flying school sets. The SPL is a training licence, not a licence to carry anyone or to fly for payment.',
  },
  {
    q: 'Do SPL hours count towards a CPL?',
    a: 'Yes. The 200 hours Section J requires for a CPL is a total of time as pilot of an aeroplane, and training hours logged from the SPL stage onward sit inside that total. Watch the five-year recency window in paragraph 1(e) when you plan the application.',
  },
  {
    q: 'Do I need Physics and Maths for an SPL?',
    a: 'The 10+2 with Physics and Mathematics requirement belongs to the CPL, under paragraph 1(b) of Section J. If a commercial licence is the goal, clear both subjects early — through NIOS if your school stream did not include them — because that gate arrives later regardless.',
  },
];

const faqs = [
  { q: 'What is a Student Pilot Licence (SPL)?', a: 'The first licence in the Indian chain. The DGCA issues it under Schedule II, Section B of the Aircraft Rules, 1937, and it permits flight training, including solo flying under instructor authorisation. It does not permit carrying passengers or flying for payment.' },
  { q: 'What is the minimum age for an SPL in India?', a: 'Sixteen years, set by Schedule II, Section B. It is the earliest formal entry point into the licensing chain.' },
  { q: 'Is SPL the same as a Sport Pilot Licence?', a: 'No. Sport Pilot is a United States FAA category with no equivalent under Indian rules. In India, SPL means Student Pilot Licence. The two get confused often enough that it is worth stating plainly.' },
  { q: 'What comes after an SPL?', a: 'A Private Pilot Licence at 17, then a Commercial Pilot Licence at 18 once you hold 200 hours of flight time. Each step builds on the licence and the hours below it.' },
  { q: 'Do I need a medical certificate for an SPL?', a: 'Yes, a DGCA medical certificate is part of entering training. Book it before you commit money to a flying school, because finding a disqualifying condition afterwards is an expensive way to learn it.' },
  { q: 'Does We One Aviation issue the SPL?', a: 'No. The DGCA issues licences. We teach the ground subjects and help students plan the route, and the flying happens at a flying school. Being clear about that line saves people a wasted phone call.' },
];

const splCourseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Student Pilot Licence (SPL) Guidance and Ground Preparation',
  description: 'Student Pilot Licence (SPL) in India: the first licence in the DGCA chain, issued under Schedule II, Section B of the Aircraft Rules, 1937, with a minimum age of 16. Covers what the licence permits, how it leads to a PPL and CPL, and the ground subjects behind it.',
  inLanguage: 'en-IN',
  dateModified: LAST_UPDATED_ISO,
  url: 'https://weoneaviation.in/student-pilot-license-spl',
  educationalCredentialAwarded: 'Preparation towards the DGCA Student Pilot Licence',
  coursePrerequisites: 'Minimum age 16 (Aircraft Rules, 1937, Schedule II, Section B) and a DGCA medical certificate.',
  teaches: ['Air Regulations', 'Basic Air Navigation', 'Aviation Meteorology', 'Aircraft Technical Knowledge', 'Normal and emergency procedures'],
  provider: { '@type': 'EducationalOrganization', name: 'We One Aviation Academy', url: 'https://weoneaviation.in' },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'blended',
    location: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Dwarka, New Delhi', addressCountry: 'IN' } },
  },
};

export default function SPL() {
  return (
    <Layout
      title="Student Pilot Licence (SPL) in India: Age 16, Eligibility | We One Aviation"
      description="SPL stands for Student Pilot Licence — the first licence in the DGCA chain, minimum age 16 under Schedule II, Section B of the Aircraft Rules, 1937. What it permits, what it does not, and how it leads to a PPL and CPL."
    >
      <StructuredData data={[splCourseSchema, generateFAQSchema(faqs)]} />

      <header className="bg-gradient-to-br from-av-blue via-av-navy to-av-blue py-24 px-4">
        <div className="max-w-4xl mx-auto text-center">
          <p className="section-tag justify-center">Student Pilot Licence</p>
          <h1 className="font-montserrat text-3xl md:text-5xl font-black text-white leading-tight">
            Student Pilot Licence (SPL) in India
          </h1>
          <p className="text-white/70 text-sm mt-4 max-w-2xl mx-auto">
            The first licence in the chain, and the earliest point at which most students can formally begin.
          </p>
        </div>
      </header>

      <section className="py-16 px-4">
        <div className="max-w-7xl mx-auto grid lg:grid-cols-3 gap-10">
          <article className="lg:col-span-2">
            <ScrollReveal>
              <Breadcrumb />

              {/*
                Inverted pyramid, and the disambiguation goes first: the single
                most common error on this topic is confusing SPL with the US
                Sport Pilot certificate, so the answer states which licence this
                is before anything else.
              */}
              <QuickAnswer
                question="What is an SPL, and what does a Student Pilot Licence allow?"
                answer="SPL stands for Student Pilot Licence — the first licence the DGCA issues. Schedule II, Section B of the Aircraft Rules, 1937 sets a minimum age of 16. It permits flight training, including solo flying under instructor authorisation, but never carrying passengers or flying for payment."
              />

              <SummaryBox
                title="SPL at a glance"
                items={[
                  'Full form: Student Pilot Licence — not Sport Pilot, which is a United States FAA category with no Indian equivalent',
                  'Minimum age: 16 years (Aircraft Rules, 1937, Schedule II, Section B)',
                  'Issued by: the Directorate General of Civil Aviation',
                  'What it permits: flight training, including solo flying under instructor authorisation',
                  'What it does not permit: carrying passengers, or any flying for payment',
                  'Medical: a DGCA medical certificate is part of entering training',
                  'Next step: a Private Pilot Licence at 17, then a Commercial Pilot Licence at 18',
                ]}
              />

              <p className="text-gray-500 text-xs mb-8">{`Last updated: ${LAST_UPDATED}`}</p>

              <h2 className="font-montserrat text-xl font-bold text-av-blue mb-3">Is an SPL the same as a Sport Pilot Licence?</h2>
              <p className="text-gray-600 text-sm leading-relaxed mb-8">
                No, and the confusion costs students time. Sport Pilot is a United States FAA certificate covering light-sport aircraft. India has no equivalent category. When an Indian flying school, the DGCA or this page says SPL, it means Student Pilot Licence — the training licence under Schedule II, Section B. If you have been comparing Indian schools against a Sport Pilot syllabus, you have been reading about a different country.
              </p>

              <h2 className="font-montserrat text-xl font-bold text-av-blue mb-3">What is the minimum age for a Student Pilot Licence?</h2>
              <p className="text-gray-600 text-sm leading-relaxed mb-8">
                Sixteen years. That puts the SPL a year ahead of the PPL and two ahead of the CPL, which is why students who are serious about an airline career often start the paperwork while still in school. The licence chain below shows where each age gate sits.
              </p>

              <h2 className="font-montserrat text-xl font-bold text-av-blue mb-3">How does an SPL lead to a CPL?</h2>
              <p className="text-gray-600 text-sm leading-relaxed mb-5">
                Each licence sits on the one below it, and the hours you fly carry forward. The 200 hours a CPL requires is a total of time as pilot of an aeroplane, so training logged from the SPL stage counts towards it.
              </p>
              <div className="overflow-x-auto rounded-xl border border-gray-200 mb-4">
                <table className="w-full text-sm">
                  <caption className="sr-only">Indian pilot licence chain with minimum ages from Schedule II of the Aircraft Rules, 1937</caption>
                  <thead>
                    <tr className="bg-av-blue text-white">
                      <th scope="col" className="p-3 text-left text-xs font-semibold">Licence</th>
                      <th scope="col" className="p-3 text-left text-xs font-semibold">Minimum age</th>
                      <th scope="col" className="p-3 text-left text-xs font-semibold">Schedule II</th>
                      <th scope="col" className="p-3 text-left text-xs font-semibold">What it permits</th>
                    </tr>
                  </thead>
                  <tbody>
                    {licenceLadder.map((row, i) => (
                      <tr key={row.licence} className={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                        <th scope="row" className="p-3 text-av-blue font-semibold text-xs text-left align-top">{row.licence}</th>
                        <td className="p-3 text-av-orange font-semibold text-xs whitespace-nowrap">{row.age}</td>
                        <td className="p-3 text-gray-500 text-xs whitespace-nowrap">{row.section}</td>
                        <td className="p-3 text-gray-600 text-xs">{row.what}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p className="text-gray-500 text-xs mb-10">
                Ages are set by the Aircraft Rules, 1937, continued in force by section 43(2) of the Bharatiya Vayuyan Adhiniyam, 2024.
              </p>

              <h2 className="font-montserrat text-xl font-bold text-av-blue mb-3">What should you do first?</h2>
              <p className="text-gray-600 text-sm leading-relaxed mb-4">
                Book the DGCA medical before you pay a flying school anything. A disqualifying condition found after a deposit is the most expensive discovery in this process, and it is entirely avoidable.
              </p>
              <p className="text-gray-600 text-sm leading-relaxed mb-10">
                Then start the ground subjects. Air Regulations, navigation, meteorology and technical knowledge underpin every licence above this one, and clearing them early means the flying is the only thing left to schedule. Our{' '}
                <Link href="/dgca-ground-classes" className="text-av-orange font-semibold hover:underline">DGCA ground classes</Link>{' '}
                cover the written papers, and the{' '}
                <Link href="/courses/cpl" className="text-av-orange font-semibold hover:underline">CPL page</Link>{' '}
                sets out where the chain ends up.
              </p>

              <PeopleAlsoAsk items={peopleAlsoAsk} />

              <section className="mt-10">
                <h2 className="font-montserrat text-2xl font-bold text-av-blue mb-6">Student Pilot Licence: frequently asked questions</h2>
                <div className="space-y-3">
                  {faqs.map((faq) => (
                    <details key={faq.q} className="rounded-xl border border-gray-200 bg-white p-5">
                      <summary className="cursor-pointer font-montserrat font-bold text-av-blue text-sm list-none">{faq.q}</summary>
                      <p className="mt-3 text-sm leading-relaxed text-gray-600">{faq.a}</p>
                    </details>
                  ))}
                </div>
              </section>

              <aside className="bg-av-blue rounded-2xl p-8 text-center my-10">
                <h3 className="font-montserrat text-xl font-bold text-white mb-3">Starting at 16?</h3>
                <p className="text-white/70 text-sm leading-relaxed max-w-xl mx-auto mb-5">
                  Tell us where you are in school and we will map the medical, the ground subjects and the licence gates against your dates.
                </p>
                <a
                  href="https://wa.me/919355611996"
                  target="_blank"
                  rel="noopener noreferrer"
                  className="inline-block bg-av-orange text-white px-8 py-3 rounded-full font-bold hover:bg-white hover:text-av-blue transition-all text-sm"
                >
                  Talk to an instructor
                </a>
              </aside>
            </ScrollReveal>
          </article>

          <aside className="space-y-6">
            <ScrollReveal delay={200}>
              <LeadForm title="Ask about the SPL route" />
            </ScrollReveal>
            <ScrollReveal delay={300}>
              <div className="bg-av-blue rounded-2xl p-6 text-white">
                <h4 className="font-montserrat font-bold mb-4">SPL requirements</h4>
                <ul className="space-y-2 text-sm text-white/80">
                  <li>✓ Minimum 16 years of age (Schedule II, Section B)</li>
                  <li>✓ A DGCA medical certificate</li>
                  <li>✓ Enrolment with a flying school</li>
                  <li>✓ English language proficiency</li>
                </ul>
              </div>
            </ScrollReveal>
            <ScrollReveal delay={400}>
              <div className="bg-av-light rounded-2xl p-6">
                <h4 className="font-montserrat font-bold text-av-blue mb-2">Planning ahead</h4>
                <p className="text-gray-600 text-sm mb-3">
                  If a commercial licence is the goal, the Physics and Mathematics requirement arrives at the CPL stage. Clear it early.
                </p>
                <Link href="/commercial-pilot-license-eligibility" className="text-av-orange font-semibold text-sm hover:underline">
                  CPL eligibility →
                </Link>
              </div>
            </ScrollReveal>
          </aside>
        </div>
      </section>
    </Layout>
  );
}
